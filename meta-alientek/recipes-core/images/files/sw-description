software =
{
    version = "@@DISTRO_VERSION@@";
    description = "alientek alpha single swu with a/b rootfs";
    hardware-compatibility: [ "1.0" ];

    stable:
    {
        slotA:
        {
            images: (
                {
                    filename = "alientek-image-base-imx6ull-alientek-alpha.rootfs.ext4.gz";
                    device = "/dev/mmcblk0p2";
                    compressed = true;
                },
                {
                    filename = "u-boot.imx";
                    device = "/dev/mmcblk0";
                    offset = "1K";
                }
            );

            files: (
                {
                    filename = "zImage";
                    path = "/zImage";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                },
                {
                    filename = "imx6ull-alientek-alpha.dtb";
                    path = "/imx6ull-alientek-alpha.dtb";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                },
                {
                    filename = "boot.scr";
                    path = "/boot.scr";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                }
            );

        };

        slotB:
        {
            images: (
                {
                    filename = "alientek-image-base-imx6ull-alientek-alpha.rootfs.ext4.gz";
                    device = "/dev/mmcblk0p3";
                    compressed = true;
                },
                {
                    filename = "u-boot.imx";
                    device = "/dev/mmcblk0";
                    offset = "1K";
                }
            );

            files: (
                {
                    filename = "zImage";
                    path = "/zImage";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                },
                {
                    filename = "imx6ull-alientek-alpha.dtb";
                    path = "/imx6ull-alientek-alpha.dtb";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                },
                {
                    filename = "boot.scr";
                    path = "/boot.scr";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                }
            );

        };
    };
}
