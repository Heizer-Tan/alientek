software =
{
    version = "@@DISTRO_VERSION@@";
    description = "alientek alpha single swu with a/b rootfs";

    stable:
    {
        slotA:
        {
            images: (
                {
                    filename = "alientek-image-base-imx6ull-alientek-alpha.rootfs.ext4.gz";
                    device = "/dev/mmcblk0p2";
                    compressed = true;
                    sha256 = "$swupdate_get_sha256(alientek-image-base-imx6ull-alientek-alpha.rootfs.ext4.gz)";
                },
                {
                    filename = "u-boot.imx";
                    device = "/dev/mmcblk0";
                    offset = "1K";
                    sha256 = "$swupdate_get_sha256(u-boot.imx)";
                }
            );

            files: (
                {
                    filename = "zImage";
                    path = "/zImage";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                    sha256 = "$swupdate_get_sha256(zImage)";
                },
                {
                    filename = "imx6ull-alientek-alpha.dtb";
                    path = "/imx6ull-alientek-alpha.dtb";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                    sha256 = "$swupdate_get_sha256(imx6ull-alientek-alpha.dtb)";
                },
                {
                    filename = "boot.scr";
                    path = "/boot.scr";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                    sha256 = "$swupdate_get_sha256(boot.scr)";
                }
            );

            bootenv: (
                { name = "active_slot"; value = "A"; },
                { name = "upgrade_available"; value = "1"; },
                { name = "bootcount"; value = "0"; }
            );
        };

        slotB:
        {
            images: (
                {
                    filename = "alientek-image-base-imx6ull-alientek-alpha.rootfs.ext4.gz";
                    device = "/dev/mmcblk0p3";
                    compressed = true;
                    sha256 = "$swupdate_get_sha256(alientek-image-base-imx6ull-alientek-alpha.rootfs.ext4.gz)";
                },
                {
                    filename = "u-boot.imx";
                    device = "/dev/mmcblk0";
                    offset = "1K";
                    sha256 = "$swupdate_get_sha256(u-boot.imx)";
                }
            );

            files: (
                {
                    filename = "zImage";
                    path = "/zImage";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                    sha256 = "$swupdate_get_sha256(zImage)";
                },
                {
                    filename = "imx6ull-alientek-alpha.dtb";
                    path = "/imx6ull-alientek-alpha.dtb";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                    sha256 = "$swupdate_get_sha256(imx6ull-alientek-alpha.dtb)";
                },
                {
                    filename = "boot.scr";
                    path = "/boot.scr";
                    device = "/dev/mmcblk0p1";
                    filesystem = "vfat";
                    properties = {
                        atomic-install = "true";
                    };
                    sha256 = "$swupdate_get_sha256(boot.scr)";
                }
            );

            bootenv: (
                { name = "active_slot"; value = "B"; },
                { name = "upgrade_available"; value = "1"; },
                { name = "bootcount"; value = "0"; }
            );
        };
    };
}
