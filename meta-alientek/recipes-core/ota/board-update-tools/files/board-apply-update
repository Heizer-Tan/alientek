#!/bin/sh

set -eu

LIB="${BOARD_SLOT_LIB:-/usr/share/board-update-tools/board-slot-lib.sh}"
# shellcheck disable=SC1090
. "${LIB}"

requireFile() {
    swuPath="$1"
    if [ ! -f "${swuPath}" ]; then
        printf '升级包不存在: %s\n' "${swuPath}" >&2
        exit 1
    fi
}

parseArgs() {
    autoReboot="0"

    case "$#" in
        1)
            swuPath="$1"
            ;;
        2)
            if [ "$1" != "--reboot" ]; then
                printf '未知参数: %s\n' "$1" >&2
                exit 1
            fi
            autoReboot="1"
            swuPath="$2"
            ;;
        *)
            printf '用法: %s [--reboot] <update.swu>\n' "$0" >&2
            exit 1
            ;;
    esac
}

performRebootIfRequested() {
    if [ "${autoReboot}" != "1" ]; then
        return 0
    fi

    printf '即将自动重启以切换到新槽位\n' >&2
    sync
    reboot
}

main() {
    parseArgs "$@"
    requireFile "${swuPath}"
    if ! board_require_safe_upgrade_state; then
        exit 1
    fi
    targetSlot="$(board_select_target_slot)"
    mode="$(board_select_swu_mode)"
    printf '当前槽位: %s，目标槽位: %s，执行模式: %s\n' \
        "$(board_read_active_slot)" "${targetSlot}" "${mode}" >&2
    set +e
    /usr/bin/swupdate -v -i "${swuPath}" -e "${mode}"
    swupdateStatus="$?"
    set -e
    if [ "${swupdateStatus}" -ne 0 ]; then
        printf 'swupdate 失败，退出码 %s（请检查 .swu 是否完整、硬件版本 hwrevision、目标分区是否可写）\n' \
            "${swupdateStatus}" >&2
        exit "${swupdateStatus}"
    fi
    /usr/bin/fw_setenv active_slot "${targetSlot}"
    /usr/bin/fw_setenv upgrade_available 1
    /usr/bin/fw_setenv bootcount 0
    printf '升级完成，已切换活动槽位到 %s\n' "${targetSlot}" >&2
    performRebootIfRequested
}

main "$@"
