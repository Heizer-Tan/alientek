From: Alientek BSP <devnull@alientek.local>
Subject: [PATCH] mx6ullevk: default fdt_file to imx6ull-alientek-alpha

EVK 默认 fdt_file=undefined，findfdt 会选 14x14-evk.dtb。
阿尔法板改为固定板级 DTB 名。

--- a/include/configs/mx6ullevk.h
+++ b/include/configs/mx6ullevk.h
@@ -29,7 +29,7 @@
 	"console=ttymxc0\0" \
 	"fdt_high=0xffffffff\0" \
 	"initrd_high=0xffffffff\0" \
-	"fdt_file=undefined\0" \
+	"fdt_file=imx6ull-alientek-alpha.dtb\0" \
 	"fdt_addr=0x83000000\0" \
 	"boot_fdt=try\0" \
 	"ip_dyn=yes\0" \
@@ -64,9 +64,9 @@
 		"findfdt="\
 			"if test $fdt_file = undefined; then " \
 				"if test $board_name = ULZ-EVK && test $board_rev = 14X14; then " \
-					"setenv fdt_file imx6ulz-14x14-evk.dtb; fi; " \
+					"setenv fdt_file imx6ull-alientek-alpha.dtb; fi; " \
 				"if test $board_name = EVK && test $board_rev = 14X14; then " \
-					"setenv fdt_file imx6ull-14x14-evk.dtb; fi; " \
+					"setenv fdt_file imx6ull-alientek-alpha.dtb; fi; " \
 				"if test $fdt_file = undefined; then " \
 					"echo WARNING: Could not determine dtb to use; " \
 				"fi; " \
