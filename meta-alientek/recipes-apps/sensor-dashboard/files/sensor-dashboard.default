# sensor-dashboard（板级控制台 / Qt6 linuxfb）运行时配置
# SENSOR_DASHBOARD_FB=/dev/fb0
# SENSOR_DASHBOARD_TOUCH_DEV=   # 空则由 Qt evdev 自动枚举；可填 /dev/input/eventX
# SENSOR_DASHBOARD_AP_DEV=/dev/ap3216c
# SENSOR_DASHBOARD_ICM_IIO_NAME=icm20608
# SENSOR_DASHBOARD_IFACE=eth0
# SENSOR_DASHBOARD_LED_NAME=alientek-led0
# SENSOR_DASHBOARD_BEEP_NAME=beep
# SENSOR_DASHBOARD_HOME_MS=1000
# SENSOR_DASHBOARD_DETAIL_MS=500
# QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
# QT_QPA_FONTDIR=/usr/share/fonts
