# short-description: Create SD card image with A/B rootfs partitions
# long-description:
# Create an image with a shared boot partition and duplicated rootfs slots
# for field upgrades. U-Boot is written raw before the partition table.

# 磁盘布局：
#  - --------- -------------- -------------- --------------
# | | u-boot  |     boot     |   rootfsA    |   rootfsB    |
#  - --------- -------------- -------------- --------------
# ^ ^         ^              ^              ^
# | |         |              |              |
# 0 1kiB    4MiB          16MiB         rootfsA + 16MiB

part u-boot --source rawcopy --sourceparams="file=${UBOOT_BINARY}.tagged" --ondisk mmcblk --no-table --align 1
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 4096 --size 16
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfsA --align 4096
part /standby --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfsB --align 4096

bootloader --ptable msdos
